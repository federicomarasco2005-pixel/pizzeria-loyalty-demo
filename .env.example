# --- Pizzeria ---
PIZZERIA_NAME=Pizzeria Da Mario
PROGRAM_NAME=Tessera Amici della Pizza
REWARD_TEXT=Una pizza margherita omaggio
STAMPS_FOR_REWARD=6
BRAND_COLOR=#b3261e

# --- Server ---
PORT=3000
# URL pubblico HTTPS con cui il server è raggiungibile (es. tunnel cloudflared o Render).
# Serve per il QR del tavolo, il logo del pass e il link "Salva in Google Wallet".
PUBLIC_URL=https://esempio.trycloudflare.com
# PIN per pagina staff e dashboard
STAFF_PIN=1234
# Secondi minimi tra due timbri allo stesso cliente (0 = nessun limite, comodo in demo)
STAMP_COOLDOWN_SEC=0

# --- Google Wallet ---
# Issuer ID dalla Google Pay & Wallet Console
GOOGLE_ISSUER_ID=
# Percorso del file JSON della service account
GOOGLE_KEY_FILE=./service-account.json
# Suffisso della classe loyalty (cambialo se cambi nome/colore e vuoi una classe nuova)
GOOGLE_CLASS_SUFFIX=pizzeria_demo_v1
# Opzionale: URL pubblico di un logo PNG/JPG quadrato (default: PUBLIC_URL/logo.png)
LOGO_URL=
